<!doctype html><html lang="en" x-data="{dark:localStorage.getItem('dept-theme')!=='light'}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Department Inventory</title><script src="https://cdn.tailwindcss.com"></script><script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/app.css"></head><body :class="dark?'dark':''" class="bg-[#f5f3ed] text-slate-800 dark:bg-[#0b0f1a] dark:text-[#f5f1e8]"><% if(user){ %><div class="min-h-screen md:flex"><aside class="sidebar"><a href="/" class="brand"><span class="monogram">D</span><span><b>DEPT.</b><small>INVENTORY OFFICE</small></span></a><nav><a href="/">◈ Dashboard</a><% if(user.role==='Coordinator'){ %><a href="/inventory">▦ Inventory</a><a href="/issue">＋ Issue item</a><a href="/returns">↩ Returns</a><a href="/students">♙ Students</a><a href="/locations">⌂ Locations</a><a href="/policies">⚙ Policies</a><% } %><a href="/renewals">↻ Renewals</a><a href="/reports">▤ Reports</a></nav><div class="sidebar-foot">QUIETLY PRECISE<br><span>Asset stewardship</span></div></aside><main class="flex-1 min-w-0"><header class="topbar"><span><%= title %></span><div class="ml-auto flex items-center gap-3"><span class="date-chip">◷ <%= today %></span><button class="icon-btn" @click="dark=!dark;localStorage.setItem('dept-theme',dark?'dark':'light')">◐</button><div class="hidden sm:block text-right text-xs"><b><%= user.name %></b><div class="muted"><%= user.role %></div></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet-btn">Sign out</button></form></div></header><div class="content"><% if(message){ %><div class="toast <%= message.type %>" role="status"><%= message.text %></div><% } %><% } else { %><% } %>