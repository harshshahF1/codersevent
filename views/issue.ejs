<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">CONTROLLED ISSUE</p><h1>Issue an item</h1><p class="muted">Loan due date is calculated automatically as issue date + 15 days.</p></div></div><div class="form-page panel"><form method="post" action="/issue" class="form-grid" x-data="{date:'<%= today %>'}"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="col-span-full">Registered student<select name="studentId" required><option value="">Select student</option><% students.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %> · <%= s.enrolment_number %></option><% }) %></select></label><label>Inventory item<select name="itemId" required><option value="">Select item</option><% items.forEach(i=>{ %><option value="<%= i.id %>"><%= i.name %> · <%= i.item_code %> (<%= i.tracking_type %>)</option><% }) %></select></label><label>Asset ID (required for assets)<select name="assetId"><option value="">Select available asset</option><% assets.forEach(a=>{ %><option value="<%= a.id %>"><%= a.asset_id %></option><% }) %></select></label><label>Quantity<input name="quantity" type="number" min="1" max="10" value="1" required></label><label>Issue date<input name="issueDate" type="date" max="<%= today %>" required x-model="date"></label><label>Calculated due date<input readonly :value="date?new Date(new Date(date+'T00:00:00Z').getTime()+15*86400000).toISOString().slice(0,10):''"></label><label class="col-span-full">Purpose<textarea name="purpose" rows="3" required></textarea></label><div class="info-note col-span-full">Server-side validation remains authoritative. Individual assets can only be issued one at a time.</div><button class="primary-btn col-span-full">Confirm issue & generate acknowledgement</button></form></div><%- include('partials/footer') %>