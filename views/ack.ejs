<%- include('partials/header',{title}) %><div class="ack-actions"><a href="/reports" class="secondary-btn">← Back to records</a><a href="/ack/<%= i.id %>.pdf" class="primary-btn">Download PDF</a><button onclick="window.print()" class="secondary-btn">Print acknowledgement</button></div><article class="ack-paper"><div class="ack-brand"><span class="monogram">D</span><div><p class="eyebrow">DEPARTMENT OPERATIONS</p><h1>Item Issue Acknowledgement</h1><p>Department Inventory & Student Item Issue Management System</p></div></div><div class="ack-id">ACKNOWLEDGEMENT NO. <b><%= String(i.id).padStart(5,'0') %></b></div><h2>Student details</h2><div class="ack-grid"><div><small>Full name</small><b><%= i.student_name %></b></div><div><small>Enrolment number</small><b><%= i.enrolment_number %></b></div><div><small>Programme / semester</small><b><%= i.programme %> · <%= i.semester %></b></div></div><h2>Issued item</h2><div class="ack-grid"><div><small>Item</small><b><%= i.item_name %></b></div><div><small>Item code</small><b><%= i.item_code %></b></div><div><small>Asset ID</small><b><%= i.asset_id||'Quantity-based stock' %></b></div><div><small>Quantity</small><b><%= i.quantity %></b></div><div><small>Issue date</small><b><%= i.issue_date %></b></div><div><small>Return due date</small><b><%= i.due_date %></b></div></div><h2>Purpose & responsibility</h2><p><%= i.purpose %></p><p class="ack-note">I acknowledge receipt of the item(s) listed above and agree to return them by the due date in the recorded condition, subject to departmental policy.</p><div class="signature-grid"><div><span></span><b><%= i.student_name %></b><small>Student signature / date</small></div><div><span></span><b><%= i.issuer_name %></b><small>Authorised staff / date</small></div></div><div class="ack-footer">Generated from the department inventory register · Keep this acknowledgement for your records.</div></article><%- include('partials/footer') %>