<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">OVERVIEW · <%= today %></p><h1><%= isAdmin?'Inventory overview':'My dashboard' %></h1><p class="muted"><%= isAdmin?'Department stock and active lending at a glance.':'Your current loans and return deadlines.' %></p></div><% if(isAdmin){ %><a href="/issue" class="primary-btn">＋ Issue an item</a><% } %></div><div class="kpi-grid"><div class="kpi"><span>Catalogue items</span><strong><%= stats.items %></strong><small>Active inventory</small></div><div class="kpi"><span>Available units</span><strong><%= stats.available %></strong><small>Ready to issue</small></div><div class="kpi"><span>Outstanding units</span><strong><%= stats.issued %></strong><small>Currently issued</small></div><div class="kpi"><span>Overdue loans</span><strong class="<%= stats.overdue?'text-rose-500':'' %>"><%= stats.overdue %></strong><small>Require attention</small></div></div><% if(issues.some(i=>i.overdue)){ %><div class="reminder-banner"><b>Return reminder</b><p><%= issues.filter(i=>i.overdue).length %> outstanding loan(s) are overdue. Please contact the department coordinator.</p></div><% } %><div class="section-head"><div><h2><%= isAdmin?'Active issues':'My active loans' %></h2><p class="muted">Outstanding quantities and due-date status</p></div><a class="text-link" href="/reports">View records →</a></div><div class="table-wrap"><table><thead><tr><th>Item / asset</th><% if(isAdmin){ %><th>Student</th><% } %><th>Outstanding</th><th>Issue date</th><th>Due date</th><th>Status</th><th></th></tr></thead><tbody><% issues.forEach(i=>{ %><tr><td><b><%= i.item_name %></b><small><%= i.asset_id||'Quantity stock' %></small></td><% if(isAdmin){ %><td><%= i.student_name %><small><%= i.enrolment_number %></small></td><% } %><td><%= i.outstanding %></td><td><%= i.issue_date %></td><td><%= i.due_date %></td><td><span class="status <%= i.overdue?'overdue':'active' %>"><%= i.overdue?'Overdue · '+i.overdueDays+'d':'Active' %></span></td><td><a class="text-link" href="/ack/<%= i.id %>">Acknowledgement</a></td></tr><% }) %><% if(!issues.length){ %><tr><td colspan="7" class="empty-cell">No active issues. Records appear here when items are issued.</td></tr><% } %></tbody></table></div><% if(isAdmin){ %><div class="section-head"><div><h2>Inventory at a glance</h2><p class="muted">Active catalogue and storage locations</p></div><a class="text-link" href="/inventory">Manage inventory →</a></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Code</th><th>Category</th><th>Tracking</th><th>Location</th></tr></thead><tbody><% items.forEach(it=>{ %><tr><td><b><%= it.name %></b></td><td><%= it.item_code %></td><td><%= it.category %></td><td><%= it.tracking_type %></td><td><%= it.location_name||'—' %></td></tr><% }) %></tbody></table></div><div class="chart-grid"><div class="panel"><h3>Stock status</h3><canvas id="stockChart" height="180"></canvas></div><div class="panel"><h3>Outstanding loans</h3><canvas id="loanChart" height="180"></canvas></div></div><script>window.dashboardCharts={available:<%= stats.available %>,issued:<%= stats.issued %>,overdue:<%= stats.overdue %>};</script><form class="panel date-form" method="post" action="/system-date"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><h3>Demo system date</h3><p class="muted">Set a date to test overdue reminders; blank restores today's real date.</p></div><input type="date" name="system_date_override" value="<%= today %>"><button class="secondary-btn">Update date</button></form><div class="section-head"><h2>Pending renewals</h2><a class="text-link" href="/renewals">Review →</a></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Item</th><th>Request date</th><th>Old due date</th></tr></thead><tbody><% renewals.forEach(r=>{ %><tr><td><%= r.student_name||'You' %></td><td><%= r.item_name %></td><td><%= r.request_date %></td><td><%= r.old_due_date %></td></tr><% }) %><% if(!renewals.length){ %><tr><td colspan="4" class="empty-cell">No renewal requests to show.</td></tr><% } %></tbody></table></div><% }else{ %><div class="section-head"><h2>Renewal tracker</h2><a class="text-link" href="/renewals">Open renewals →</a></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Requested</th><th>Status</th><th>Remarks</th></tr></thead><tbody><% renewals.forEach(r=>{ %><tr><td><%= r.item_name %></td><td><%= r.request_date %></td><td><%= r.status %></td><td><%= r.remarks||r.reason||'Awaiting review' %></td></tr><% }) %></tbody></table></div><% } %><%- include('partials/footer') %>