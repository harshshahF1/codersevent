<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">STUDENT REGISTER</p><h1>Students</h1><p class="muted">Registered student accounts and programme details.</p></div><input id="tableSearch" class="search-box" placeholder="Search students…"></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Enrolment number</th><th>Programme</th><th>Semester</th><th>Email</th><th>Phone</th><th>Registered</th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td><b><%= s.name %></b></td><td><%= s.enrolment_number %></td><td><%= s.programme %></td><td><%= s.semester %></td><td><%= s.email||'—' %></td><td><%= s.phone||'—' %></td><td><%= s.registered?'Yes':'No' %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>