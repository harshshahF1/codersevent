<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">PHYSICAL STORAGE</p><h1>Storage locations</h1><p class="muted">Give every stock unit and asset a clear home.</p></div></div><div class="split-panels"><section class="panel"><h2>Add location</h2><form method="post" action="/locations" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Location name<input name="name" required></label><label>Type<select name="type"><option>department</option><option>laboratory</option><option>room</option><option>cupboard</option><option>other</option></select></label><label>Description<input name="description"></label><button class="primary-btn">Add location</button></form></section><section class="panel"><h2>Location register</h2><% locations.forEach(l=>{ %><div class="location-card"><span class="location-icon">⌂</span><div><b><%= l.name %></b><p class="muted"><%= l.type %> · <%= l.description||'No description' %></p></div></div><% }) %></section></div><%- include('partials/footer') %>