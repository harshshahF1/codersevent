<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">RECORDS & ACCOUNTABILITY</p><h1>Records & reports</h1><p class="muted">Filter, print and export issue history.</p></div><div class="flex gap-2 flex-wrap"><a class="secondary-btn" href="/export/issues.csv">Export CSV</a><a class="secondary-btn" href="/export/issues.pdf">Export PDF</a><button class="secondary-btn" onclick="window.print()">Print</button></div></div><div class="section-head"><h2><%= isAdmin?'Issue transaction history':'My issue history' %></h2><input id="tableSearch" class="search-box" placeholder="Filter records…"></div><div class="filter-row"><label>From <input type="date" id="fromDate"></label><label>To <input type="date" id="toDate"></label></div><div class="table-wrap"><table id="recordsTable"><thead><tr><th>ID</th><th>Student</th><th>Item</th><th>Qty</th><th>Returned</th><th>Issue date</th><th>Due date</th><th>Purpose</th></tr></thead><tbody><% rows.forEach(i=>{ %><tr data-date="<%= i.issue_date %>"><td><%= i.id %></td><td><%= i.student_name %><small><%= i.enrolment_number %></small></td><td><%= i.item_name %></td><td><%= i.quantity %></td><td><%= i.returned_quantity %></td><td><%= i.issue_date %></td><td><%= i.due_date %></td><td><%= i.purpose %></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="8" class="empty-cell">No issue records found.</td></tr><% } %></tbody></table></div><% if(isAdmin){ %><div class="section-head"><h2>Recent audit log</h2></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= l.timestamp %></td><td><%= l.full_name||'System' %></td><td><%= l.action %></td><td><%= l.entity %></td><td><%= l.details %></td></tr><% }) %></tbody></table></div><% } %><%- include('partials/footer') %>