<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">RECEIPT & INSPECTION</p><h1>Returns</h1><p class="muted">Record receipt and condition before restoring stock.</p></div><input id="tableSearch" class="search-box" placeholder="Search active issues…"></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Item / asset</th><th>Due date</th><th>Outstanding</th><th>Record receipt</th></tr></thead><tbody><% issues.forEach(i=>{ %><tr><td><b><%= i.student_name %></b><small><%= i.enrolment_number %></small></td><td><%= i.item_name %><small><%= i.asset_id||'Quantity stock' %></small></td><td><%= i.due_date %></td><td><%= i.outstanding %></td><td><form method="post" action="/returns" class="return-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="issueId" value="<%= i.id %>"><input type="number" name="quantity" min="1" max="<%= i.outstanding %>" value="<%= i.outstanding %>" required><select name="condition"><option>Usable</option><option>Damaged</option><option>Lost</option><option>Maintenance</option></select><input name="remarks" placeholder="Inspection notes"><button class="primary-btn">Record</button></form></td></tr><% }) %><% if(!issues.length){ %><tr><td colspan="5" class="empty-cell">No outstanding items to receive.</td></tr><% } %></tbody></table></div><%- include('partials/footer') %>