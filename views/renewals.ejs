<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">LOAN EXTENSIONS</p><h1>Renewals</h1><p class="muted"><%= isAdmin?'Review requests. Only approval extends the current due date.':'Request extensions before the due date and track decisions.' %></p></div></div><% if(!isAdmin){ %><div class="panel mb-6"><h2>Request renewal</h2><p class="muted">A request alone does not change your due date.</p></div><% } %><div class="table-wrap"><table><thead><tr><th>Student</th><th>Item</th><th>Requested</th><th>Old due</th><th>Status</th><th>New due</th><th>Action / remarks</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.student_name %><small><%= r.enrolment_number %></small></td><td><%= r.item_name %></td><td><%= r.request_date %></td><td><%= r.old_due_date %></td><td><span class="status <%= r.status.toLowerCase() %>"><%= r.status %></span></td><td><%= r.revised_due_date||'—' %></td><td><% if(isAdmin&&r.status==='Pending'){ %><form method="post" action="/renewals/<%= r.id %>/decision" class="decision-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="remarks" placeholder="Remarks"><button class="primary-btn" name="decision" value="approve">Approve</button><button class="danger-btn" name="decision" value="reject">Reject</button></form><% }else{ %><%= r.remarks||r.reason||'—' %><% } %></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="7" class="empty-cell">No renewal records found.</td></tr><% } %></tbody></table></div><% if(!isAdmin){ %><div class="section-head"><h2>My active loans</h2></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Due date</th><th>Request</th></tr></thead><tbody><% myIssues.forEach(i=>{ %><tr><td><%= i.name %></td><td><%= i.due_date %></td><td><form method="post" action="/renewals/request/<%= i.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reason" placeholder="Optional reason"><button class="primary-btn">Request renewal</button></form></td></tr><% }) %><% if(!myIssues.length){ %><tr><td colspan="3" class="empty-cell">No active loans eligible for renewal.</td></tr><% } %></tbody></table></div><% } %><%- include('partials/footer') %>