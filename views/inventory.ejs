<%- include('partials/header',{title}) %><div class="page-heading"><div><p class="eyebrow">CATALOGUE MANAGEMENT</p><h1>Inventory</h1><p class="muted">Track reusable quantities and individually tracked assets.</p></div><input class="search-box" id="tableSearch" placeholder="Search inventory…"></div><div class="split-panels"><section class="panel"><h2>Add inventory item</h2><form method="post" action="/inventory/items" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Item code<input name="item_code" required></label><label>Item name<input name="name" required></label><label>Category<input name="category" required></label><label>Tracking type<select name="tracking_type"><option value="QUANTITY">Quantity-based</option><option value="ASSET">Individual asset</option></select></label><label>Initial quantity<input name="total_quantity" type="number" min="0" value="0"></label><label>Default location<select name="location_id"><option value="">Select location</option><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label class="col-span-full">Description<input name="description"></label><label class="col-span-full">Make / model<input name="make_model"></label><button class="primary-btn col-span-full">Create item</button></form></section><section class="panel"><h2>Add individual asset</h2><form method="post" action="/inventory/assets" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Asset ID<input name="asset_id" required placeholder="DB-011"></label><label>Inventory item<select name="item_id" required><% items.filter(i=>i.tracking_type==='ASSET').forEach(i=>{ %><option value="<%= i.id %>"><%= i.name %> · <%= i.item_code %></option><% }) %></select></label><label>Serial number<input name="serial_number"></label><label>Location<select name="location_id"><option value="">Use default</option><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Condition<select name="condition"><option>Usable</option><option>Damaged</option><option>Maintenance</option><option>Lost</option></select></label><button class="primary-btn col-span-full">Add asset</button></form></section></div><div class="section-head"><h2>Inventory register</h2></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Code</th><th>Category</th><th>Tracking</th><th>Location</th><th>Status</th><th>Action</th></tr></thead><tbody><% items.forEach(it=>{ %><tr><td><b><%= it.name %></b><small><%= it.description||'' %></small></td><td><%= it.item_code %></td><td><%= it.category %></td><td><%= it.tracking_type %></td><td><%= it.location_name||'—' %></td><td><%= it.retired?'Retired':'Active' %></td><td><% if(!it.retired){ %><form method="post" action="/inventory/retire/<%= it.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reason" placeholder="Retirement reason" required><button class="danger-btn">Retire</button></form><% } %></td></tr><% }) %></tbody></table></div><div class="section-head"><h2>Asset register</h2></div><div class="table-wrap"><table><thead><tr><th>Asset ID</th><th>Item</th><th>Serial</th><th>Location</th><th>Condition</th><th>Status</th></tr></thead><tbody><% assets.forEach(a=>{ %><tr><td><b><%= a.asset_id %></b></td><td><%= a.item_name %></td><td><%= a.serial_number||'—' %></td><td><%= a.location_name||'—' %></td><td><%= a.condition %></td><td><%= a.status %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>